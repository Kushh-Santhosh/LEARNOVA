# LEARNOVA Environment Configuration
# Copy to .env — DO NOT commit .env.
# All external providers are optional. LEARNOVA runs fully offline with local engine + browser voice.
#
# SECURITY CLASSIFICATION:
#   CLIENT_SAFE   = safe to expose to browser JS (publishable/anon keys only)
#   SERVER_ONLY   = must never leave the backend process
#   OPTIONAL      = feature degrades gracefully when absent
#
# ─────────────────────────────────────────────
# SERVER CONFIG
# ─────────────────────────────────────────────
PORT=8000                        # SERVER_ONLY  OPTIONAL — default 8000
HOST=0.0.0.0                     # SERVER_ONLY  OPTIONAL — default 0.0.0.0

# ─────────────────────────────────────────────
# PRIMARY LLM GATEWAY — OpenRouter (FREE-ONLY)
# ─────────────────────────────────────────────
# STRICT POLICY: every request is validated for $0 prompt + $0 completion cost.
# When blank, falls back to LocalTeacherProvider (always works offline).
OPENROUTER_API_KEY=              # SERVER_ONLY  OPTIONAL — sk-or-...
OPENROUTER_MODEL=                # SERVER_ONLY  OPTIONAL — leave blank for dynamic free discovery

# ─────────────────────────────────────────────
# OPTIONAL CLOUD LLM — Gemini
# ─────────────────────────────────────────────
# NOT the primary provider. Only used if explicitly wired via a future provider route.
GEMINI_API_KEY=                  # SERVER_ONLY  OPTIONAL — AIzaSy...

# ─────────────────────────────────────────────
# OPTIONAL PERSISTENCE — Supabase
# ─────────────────────────────────────────────
# When absent, LEARNOVA uses in-memory state. No data persists between restarts.
SUPABASE_URL=                    # SERVER_ONLY  OPTIONAL — https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=        # CLIENT_SAFE  OPTIONAL — anon/public key for RLS-guarded reads
SUPABASE_SECRET_KEY=             # SERVER_ONLY  OPTIONAL — service_role key; NEVER expose to browser

# ─────────────────────────────────────────────
# OPTIONAL REAL-TIME VOICE — LiveKit
# ─────────────────────────────────────────────
# Browser SpeechSynthesis remains default when absent.
LIVEKIT_URL=                     # SERVER_ONLY  OPTIONAL — wss://...
LIVEKIT_API_KEY=                 # SERVER_ONLY  OPTIONAL
LIVEKIT_API_SECRET=              # SERVER_ONLY  OPTIONAL — NEVER expose to browser

# ─────────────────────────────────────────────
# OPTIONAL LIVE AVATAR — HeyGen
# ─────────────────────────────────────────────
# Local Professor Nova PNG avatar is always the default.
HEYGEN_API_KEY=                  # SERVER_ONLY  OPTIONAL — NEVER expose to browser
HEYGEN_AVATAR_ID=                # SERVER_ONLY  OPTIONAL

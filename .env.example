# LEARNOVA Environment Variables Configuration
# Copy this file to .env and provide your credentials as needed.
# LEARNOVA works out-of-the-box with local intelligence and browser-native voice/avatar if external keys are left blank!

# Backend Port
PORT=8000
HOST=0.0.0.0

# Gemini LLM & Embeddings (Optional - unlocks cloud Gemini 1.5 / 2.0 models)
GEMINI_API_KEY=

# Supabase (Optional - unlocks remote PostgreSQL + pgvector storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Realtime Audio/Video (Optional - for WebRTC room orchestration)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloud Avatar Providers (Optional - HeyGen / LiveAvatar)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
